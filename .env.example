# ============================================================
#  Configuração. Copie para .env e preencha (o install.sh faz isso pra você).
# ============================================================

# --- Site ---------------------------------------------------
SITE_NAME=Era Uma Vez Eu
# Seu domínio, sem https:// (o Caddy cria o certificado HTTPS sozinho)
DOMAIN=seudominio.com.br
BASE_URL=https://seudominio.com.br
SUPPORT_EMAIL=contato@seudominio.com.br

# --- Painel admin (https://seudominio.com.br/admin) ---------
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Recebe alerta se alguma história falhar 3 vezes
ADMIN_EMAIL=voce@gmail.com

# --- IA (grátis, roda no próprio VPS) -----------------------
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
# gemma3:4b  -> VPS com 8 GB de RAM  (~2 min por história em 4 vCPUs)
# gemma4:e4b -> VPS com 16 GB ou mais (~8 min por história, texto bem melhor)
LLM_MODEL=gemma3:4b
# Segunda passada da IA revisando a história antes de enviar
LLM_REVIEW=true
# Opcional, para o futuro: qualquer API compatível com OpenAI (Groq, OpenRouter, OpenAI...)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...

# --- Voz (Piper, grátis, roda na CPU) -----------------------
TTS_ENABLED=true
PIPER_VOICE=pt_BR-faber-medium
# 1.0 = normal; maior = mais devagar (bom para criança)
PIPER_LENGTH_SCALE=1.15

PDF_ENABLED=true

# --- Pagamento ----------------------------------------------
# fake = modo teste (aprova sem cobrar). Troque para mercadopago para vender de verdade.
PAYMENT_PROVIDER=fake
# Mercado Pago > Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
# Nome que aparece na fatura do cartão (até 13 letras)
MP_STATEMENT_DESCRIPTOR=HISTORINHAS

# --- E-mail (SMTP) ------------------------------------------
# Grátis: Brevo (300 e-mails/dia). Sem SMTP_HOST, os e-mails vão para data/outbox (teste).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Era Uma Vez Eu <contato@seudominio.com.br>
SMTP_SSL=false

# --- Produto ------------------------------------------------
STORY_INTERVAL_DAYS=7
RENEWAL_REMINDER_DAYS=3
PRICE_MENSAL_CENTS=2490
PRICE_TRIMESTRAL_CENTS=5990
PRICE_ANUAL_CENTS=19990
