# Modelo do .env.site (o arquivo real NÃO é versionado).
# Crie o real com: node scripts/setup-env.js --admin-email=<e-mail> --base-url=https://<nome>.metodoim.com.br
# PORT, HOSTNAME e DATA_DIR são definidos pelo servidor.

NODE_ENV=production
SITE_NAME=Era Uma Vez Eu
BASE_URL=https://era-uma-vez-eu.metodoim.com.br
SUPPORT_EMAIL=

ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# Groq (grátis): https://console.groq.com/keys. Sem chave = histórias de demonstração.
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b

# fake = teste (só o admin logado simula); mercadopago = vendas reais
PAYMENT_PROVIDER=fake
MP_ACCESS_TOKEN=
MP_STATEMENT_DESCRIPTOR=HISTORINHAS

# Brevo (grátis, 300 e-mails/dia). Sem chave = e-mails ficam em DATA_DIR/outbox.
EMAIL_PROVIDER=auto
BREVO_API_KEY=
EMAIL_FROM=

STORY_INTERVAL_DAYS=7
RENEWAL_REMINDER_DAYS=3
PRICE_MENSAL_CENTS=2490
PRICE_TRIMESTRAL_CENTS=5990
PRICE_ANUAL_CENTS=19990
